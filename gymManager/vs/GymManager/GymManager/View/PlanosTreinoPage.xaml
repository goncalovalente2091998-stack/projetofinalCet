<Page x:Class="GymManager.View.PlanosTreinoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Planos de Treino"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão dos planos de treino dos clientes"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Kind="Dumbbell"
                        Width="26"
                        Height="26"
                        Foreground="#2563EB"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
        <!-- BARRA -->

        <Border Grid.Row="1"
        Background="White"
        CornerRadius="12"
        Padding="15"
        Margin="0,25,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BOTÕES -->

                <WrapPanel Grid.Row="0"
                   HorizontalAlignment="Left">

                    <Button x:Name="btnNovo"
                    Width="120"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="btnNovo_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Plus"
                                             Width="18"
                                             Height="18"/>

                            <TextBlock Text="Novo"
                               Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEditar"
                   Width="120"
 Height="42"
                    Margin="0,0,10,0"
                    Click="btnEditar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Pencil"
                                             Width="18"
                                             Height="18"/>

                            <TextBlock Text="Editar"
                               Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEliminar"
                     Width="120"
 Height="42"
                    Margin="0,0,10,0"
                    Click="btnEliminar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"
                                             Width="18"
                                             Height="18"/>

                            <TextBlock Text="Eliminar"
                               Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnExercicios"
                    Width="150"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="btnExercicios_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="WeightLifter"
                                             Width="18"
                                             Height="18"/>

                            <TextBlock Text="Exercícios"
                               Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnExportarPdf"
                    Width="150"
                    Height="42"
                    Click="BtnExportarPdf_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="FilePdfBox"
                                             Width="18"
                                             Height="18"/>

                            <TextBlock Text="Exportar PDF"
                               Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                </WrapPanel>

                <!-- PESQUISA -->

                <Grid Grid.Row="1"
              Width="520"
              Height="44"
              Margin="0,16,0,0"
              HorizontalAlignment="Left">

                    <TextBox x:Name="txtPesquisar"
                     Padding="38,0,35,0"
                     VerticalContentAlignment="Center"
                     materialDesign:HintAssist.Hint="Pesquisar plano..."
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     TextChanged="txtPesquisar_TextChanged"/>

                    <materialDesign:PackIcon
                Kind="Magnify"
                Width="20"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#64748B"
                IsHitTestVisible="False"/>

                </Grid>

            </Grid>

        </Border>

        <!-- DATAGRID -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <DataGrid x:Name="dgPlanosTreino"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="42">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NomeCliente}"
                                        Width="180"/>

                    <DataGridTextColumn Header="PT"
                                        Binding="{Binding NomePT}"
                                        Width="170"/>

                    <DataGridTextColumn Header="Plano"
                                        Binding="{Binding NomePlano}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Objetivo"
                                        Binding="{Binding Objetivo}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Início"
                                        Binding="{Binding DataInicio,StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Fim"
                                        Binding="{Binding DataFim,StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="Estado"
                                            Width="120">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border CornerRadius="10"
                                        Padding="4">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#DCFCE7"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Concluído">

                                                    <Setter Property="Background"
                                                            Value="#DBEAFE"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Cancelado">

                                                    <Setter Property="Background"
                                                            Value="#FEE2E2"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding Estado}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>