<Page x:Class="GymManager.View.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <ScrollViewer>

        <StackPanel Margin="30">

            <TextBlock Text="Dashboard"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,25"/>

            <WrapPanel>

                <Border Width="220" Height="120" Margin="10" Background="White" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clientes" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtClientes"
                                   Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="220" Height="120" Margin="10" Background="White" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Professores" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtProfessores"
                                   Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="220" Height="120" Margin="10" Background="White" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Personal Trainers"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtPT"
                                   Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="220" Height="120" Margin="10" Background="White" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aulas" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAulas"
                                   Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

        </StackPanel>

    </ScrollViewer>

</Page>