<Page x:Class="GymManager.View.InscricoesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Gestão de Inscrições"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão das inscrições dos clientes"
                           Foreground="#64748B"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="ClipboardAccount"
                                             Width="26"
                                             Height="26"
                                             Foreground="#2563EB"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Barra -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,25,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="btnNovo"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="btnNovo_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Plus"/>

                            <TextBlock Text="Novo"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEditar"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="btnEditar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Pencil"/>

                            <TextBlock Text="Editar"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEliminar"
                            Width="120"
                            Height="42"
                            Click="btnEliminar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"/>

                            <TextBlock Text="Eliminar"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <Grid Grid.Column="2">

                    <TextBox x:Name="txtPesquisar"
                             Padding="38,0,35,0"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Pesquisar..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             TextChanged="txtPesquisar_TextChanged" Margin="0,10,0,-10"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="10,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"/>

                </Grid>

            </Grid>

        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">

            <DataGrid x:Name="dgInscricoes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="42">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IdInscricao}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NomeCliente}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Plano"
                                        Binding="{Binding NomePlano}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Início"
                                        Binding="{Binding DataInicio,StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Fim"
                                        Binding="{Binding DataFim,StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="Estado"
                                            Width="120">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border CornerRadius="10"
                                        Padding="3">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#FEE2E2"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Ativa">

                                                    <Setter Property="Background"
                                                            Value="#DCFCE7"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding Estado}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>