<Page x:Class="GymManager.View.InscricoesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Inscrições"
      Language="pt-PT"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <!-- Cabeçalho -->
            <RowDefinition Height="Auto"/>

            <!-- Barra de ações e pesquisa -->
            <RowDefinition Height="Auto"/>

            <!-- DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Gestão de Inscrições"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão das inscrições dos clientes"
                           Foreground="#64748B"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- TOTAL -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="ClipboardAccount"
                                             Width="26"
                                             Height="26"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,25,0,20"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <!-- Botões -->
                    <RowDefinition Height="Auto"/>

                    <!-- Pesquisa -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BOTÕES -->
                <WrapPanel Grid.Row="0"
                           Orientation="Horizontal"
                           Margin="0,0,0,14">

                    <Button x:Name="btnNovo"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnNovo_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Plus"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Novo"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEditar"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnEditar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Pencil"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Editar"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEliminar"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnEliminar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Eliminar"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnRenovar"
                            Width="140"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnRenovar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Refresh"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Renovar"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnGerarPagamento"
                            Width="180"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnGerarPagamento_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="CashPlus"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Gerar Pagamento"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </WrapPanel>

                <!-- PESQUISA -->
                <Grid Grid.Row="1"
                      Width="900"
                      Height="42"
                      HorizontalAlignment="Right">

                    <TextBox x:Name="txtPesquisar"
                             Padding="38,0,35,0"
                             VerticalContentAlignment="Center"
                             TextChanged="txtPesquisar_TextChanged"
                             materialDesign:HintAssist.Hint="Pesquisar por cliente, plano, estado ou data..."
                             materialDesign:TextFieldAssist.HasClearButton="True"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="10,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"
                                             IsHitTestVisible="False"/>

                </Grid>

            </Grid>

        </Border>

        <!-- TABELA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="dgInscricoes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="44"
                      ColumnHeaderHeight="44"
                      BorderThickness="0">

                <DataGrid.Columns>

                    

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NomeCliente}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Plano"
                                        Binding="{Binding NomePlano}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Início"
                                        Binding="{Binding DataInicio,
                                                          StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Fim"
                                        Binding="{Binding DataFim,
                                                          StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="Estado"
                                            Width="125">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="10,4"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <!-- Valor padrão: Cancelada -->
                                            <Setter Property="Background"
                                                    Value="#FEE2E2"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Ativa">

                                                    <Setter Property="Background"
                                                            Value="#DCFCE7"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Pendente">

                                                    <Setter Property="Background"
                                                            Value="#FEF3C7"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Suspensa">

                                                    <Setter Property="Background"
                                                            Value="#DBEAFE"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Terminada">

                                                    <Setter Property="Background"
                                                            Value="#E2E8F0"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Cancelada">

                                                    <Setter Property="Background"
                                                            Value="#FEE2E2"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding Estado}"
                                               FontSize="12"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <!-- Cor padrão: Cancelada -->
                                                <Setter Property="Foreground"
                                                        Value="#B91C1C"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Ativa">

                                                        <Setter Property="Foreground"
                                                                Value="#15803D"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Pendente">

                                                        <Setter Property="Foreground"
                                                                Value="#B45309"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Suspensa">

                                                        <Setter Property="Foreground"
                                                                Value="#1D4ED8"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Terminada">

                                                        <Setter Property="Foreground"
                                                                Value="#475569"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Cancelada">

                                                        <Setter Property="Foreground"
                                                                Value="#B91C1C"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>