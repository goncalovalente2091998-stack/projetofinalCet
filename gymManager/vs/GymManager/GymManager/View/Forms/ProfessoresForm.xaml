<Window x:Class="GymManager.View.Forms.ProfessoresForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Professor"
        Height="380"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">

        <Border Background="#2563EB"
                Height="60"
                VerticalAlignment="Top">

            <TextBlock Text="👨‍🏫 Professor"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0"/>

        </Border>

        <Grid Margin="20,80,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Coluna Esquerda -->

            <TextBlock Text="Nome"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="txtNome"
                     Grid.Row="1"
                     Height="35"
                     Margin="0,5,0,15"/>

            <TextBlock Grid.Row="2"
                       Text="Telefone"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="txtTelefone"
                     Grid.Row="3"
                     Height="35"
                     Margin="0,5,0,0"/>

            <!-- Coluna Direita -->

            <TextBlock Grid.Column="2"
                       Text="Especialidade"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="txtEspecialidade"
                     Grid.Column="2"
                     Grid.Row="1"
                     Height="35"
                     Margin="0,5,0,15"/>

            <TextBlock Grid.Column="2"
                       Grid.Row="2"
                       Text="Email"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="txtEmail"
                     Grid.Column="2"
                     Grid.Row="3"
                     Height="35"
                     Margin="0,5,0,0"/>

        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,20">

            <Button x:Name="btnGuardar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Content="💾 Guardar" Click="btnGuardar_Click"/>

            <Button x:Name="btnCancelar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Content="❌ Cancelar"/>

        </StackPanel>

    </Grid>

</Window>