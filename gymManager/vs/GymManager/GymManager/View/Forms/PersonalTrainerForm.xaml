<Window x:Class="GymManager.View.Forms.PersonalTrainerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Personal Trainer"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Border Background="#0F766E">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <materialDesign:PackIcon Kind="AccountTie"
                                         Width="34"
                                         Height="34"
                                         Foreground="White"/>

                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="Personal Trainer"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Dados pessoais e profissionais"
                               FontSize="13"
                               Foreground="#CCFFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Dados pessoais"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <TextBox x:Name="txtNome"
                             Height="45"
                             Margin="0,0,0,18"
                             materialDesign:HintAssist.Hint="Nome"/>

                    <TextBox x:Name="txtTelefone"
                             Height="45"
                             Margin="0,0,0,18"
                             materialDesign:HintAssist.Hint="Telefone"/>

                    <TextBox x:Name="txtEmail"
                             Height="45"
                             materialDesign:HintAssist.Hint="Email"/>

                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Dados profissionais"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <TextBox x:Name="txtEspecialidade"
                             Height="45"
                             Margin="0,0,0,18"
                             materialDesign:HintAssist.Hint="Especialidade"/>

                    <TextBox x:Name="txtValorHora"
                             Height="45"
                             Margin="0,0,0,20"
                             materialDesign:HintAssist.Hint="Valor por hora (€)"/>

                    <CheckBox x:Name="chkEstado"
                              Content="Personal Trainer ativo"
                              IsChecked="True"
                              FontSize="14"/>

                </StackPanel>
            </Border>

        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="120"
                        Height="40"
                        Click="btnGuardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>