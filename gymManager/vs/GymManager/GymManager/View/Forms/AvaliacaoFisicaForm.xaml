<Window x:Class="GymManager.View.Forms.AvaliacaoFisicaForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Avaliação Física"
         Icon="/GymManager;component/Assets/logo.ico"
        Width="760"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT"
        PreviewMouseDown="AvaliacaoFisicaForm_PreviewMouseDown"
        Deactivated="AvaliacaoFisicaForm_Deactivated">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="ChartLine"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Nova Avaliação Física"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Registar medidas e composição corporal"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CLIENTE -->
                    <Grid Grid.Row="0"
                          Grid.Column="0"
                          Height="48"
                          Margin="0,0,0,18"
                          VerticalAlignment="Top">

                        <TextBox x:Name="txtPesquisarCliente"
             Height="48"
             VerticalContentAlignment="Center"
             TextChanged="txtPesquisarCliente_TextChanged"
                              PreviewMouseLeftButtonDown="txtPesquisarCliente_PreviewMouseLeftButtonDown"
             PreviewKeyDown="txtPesquisarCliente_PreviewKeyDown"
             materialDesign:HintAssist.Hint="Pesquisar cliente..."/>

                        <Popup x:Name="popupClientes"
           PlacementTarget="{Binding ElementName=txtPesquisarCliente}"
           Placement="Bottom"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="Fade">

                            <Border Width="{Binding ActualWidth,
                                ElementName=txtPesquisarCliente}"
                Margin="0,4,0,0"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                MaxHeight="270">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="3"
                                  Opacity="0.20"/>
                                </Border.Effect>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <ListBox x:Name="lstClientes"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="lstClientes_SelectionChanged"
                         PreviewMouseLeftButtonDown="lstClientes_PreviewMouseLeftButtonDown"
                         PreviewMouseWheel="lstClientes_PreviewMouseWheel"
                         PreviewKeyDown="lstClientes_PreviewKeyDown">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="HorizontalContentAlignment"
                                                        Value="Stretch"/>

                                                <Setter Property="Padding"
                                                        Value="0"/>

                                                <Setter Property="Margin"
                                                        Value="5"/>

                                                <Setter Property="Background"
                                                        Value="Transparent"/>

                                                <Setter Property="BorderBrush"
                                                        Value="Transparent"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">

                                                            <Border x:Name="ItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="10">

                                                                <ContentPresenter/>

                                                            </Border>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="ItemBorder"
                                                                            Property="Background"
                                                                            Value="#EFF6FF"/>
                                                                    <Setter TargetName="ItemBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#93C5FD"/>
                                                                </Trigger>

                                                                <Trigger Property="IsSelected"
                                                                         Value="True">
                                                                    <Setter TargetName="ItemBorder"
                                                                            Property="Background"
                                                                            Value="#DBEAFE"/>
                                                                    <Setter TargetName="ItemBorder"
                                                                            Property="BorderBrush"
                                                                            Value="#2563EB"/>
                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>

                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Border Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="42"
                                            Height="42"
                                            CornerRadius="21"
                                            Background="#DCFCE7"
                                            VerticalAlignment="Center">

                                                            <materialDesign:PackIcon Kind="Account"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="#15803D"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>

                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Nome}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"/>

                                                            <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">

                                                                <TextBlock Text="NIF: "
                                                       Foreground="#64748B"/>

                                                                <TextBlock Text="{Binding NIF}"
                                                       Foreground="#64748B"/>

                                                                <TextBlock Text="  •  Nascimento: "
                                                       Foreground="#64748B"/>

                                                                <TextBlock Text="{Binding DataNascimento,
                                                                     StringFormat=dd/MM/yyyy}"
                                                       Foreground="#64748B"/>

                                                            </StackPanel>

                                                        </StackPanel>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>
                    <!-- PERSONAL TRAINER -->
                    <ComboBox x:Name="cmbPT"
                              Grid.Row="0"
                              Grid.Column="2"
                              Height="48"
                              Margin="0,0,0,18"
                              VerticalAlignment="Top"
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="IdPT"
                              materialDesign:HintAssist.Hint="Personal trainer"/>

                    <!-- DATA -->
                    <DatePicker x:Name="dpDataAvaliacao"
                                Grid.Row="1"
                                Height="48"
                                Margin="0,0,0,18"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.Hint="Data da avaliação"/>

                    <!-- ESTADO -->
                    <ComboBox x:Name="cmbEstado"
          Grid.Row="1"
          Grid.Column="2"
          Height="48"
          Margin="0,0,0,18"
          SelectionChanged="cmbEstado_SelectionChanged"
          materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Agendada"/>
                        <ComboBoxItem Content="Concluída"/>
                        <ComboBoxItem Content="Cancelada"/>

                    </ComboBox>

                    <!-- PESO -->
                    <TextBox x:Name="txtPeso"
                             Grid.Row="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="6"
                             VerticalContentAlignment="Center"
                             TextChanged="Medidas_TextChanged"
                             PreviewTextInput="txtDecimal_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Peso em kg"/>

                    <!-- ALTURA -->
                    <TextBox x:Name="txtAltura"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="4"
                             VerticalContentAlignment="Center"
                             TextChanged="Medidas_TextChanged"
                             PreviewTextInput="txtDecimal_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Altura em metros"/>

                    <!-- MASSA GORDA -->
                    <TextBox x:Name="txtMassaGorda"
                             Grid.Row="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="6"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtDecimal_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Massa gorda (%)"/>

                    <!-- MASSA MUSCULAR -->
                    <TextBox x:Name="txtMassaMuscular"
                             Grid.Row="3"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="6"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtDecimal_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Massa muscular (kg)"/>

                    <!-- RESUMO DO IMC -->
                    <Border Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="ScaleBathroom"
                                                     Width="25"
                                                     Height="25"
                                                     Foreground="#2563EB"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Índice de Massa Corporal"
                                           FontSize="12"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="txtClassificacaoIMC"
                                           Text="Introduza peso e altura"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E3A8A"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <TextBlock x:Name="txtIMC"
                                       Grid.Column="2"
                                       Text="--"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- OBSERVAÇÕES -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="5"
                             Grid.ColumnSpan="3"
                             Height="120"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Observações (opcional)"/>

                    <!-- NOTA -->
                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="3"
                               Text="O IMC é calculado automaticamente a partir do peso e da altura."
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,12,0,0"/>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>