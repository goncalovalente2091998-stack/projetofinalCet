<Window x:Class="GymManager.View.Forms.ClienteForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cliente"
        Height="720"
        Width="650"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="AccountPlus"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Cliente"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Dados pessoais e informação de inscrição"
                               FontSize="13"
                               Foreground="#DDE7FF"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtNome"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome completo"/>

                    <TextBox x:Name="txtNIF"
                             Grid.Row="1"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             MaxLength="9"
                             materialDesign:HintAssist.Hint="NIF"/>

                    <DatePicker x:Name="dpNascimento"
                                Grid.Row="1"
                                Grid.Column="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de nascimento"/>

                    <TextBox x:Name="txtTelefone"
                             Grid.Row="2"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Telefone"/>

                    <TextBox x:Name="txtEmail"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Email"/>

                    <TextBox x:Name="txtMorada"
                             Grid.Row="3"
                             Grid.ColumnSpan="3"
                             Height="80"
                             Margin="0,0,0,18"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             materialDesign:HintAssist.Hint="Morada"/>

                    <DatePicker x:Name="dpInscricao"
                                Grid.Row="4"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de inscrição"/>

                    <Border Grid.Row="4"
                            Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,0,0,18">

                        <StackPanel Orientation="Horizontal">

                            <CheckBox x:Name="chkEstado"
                                      Content="Cliente ativo"
                                      VerticalAlignment="Center"
                                      FontSize="14"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Row="5"
                            Grid.ColumnSpan="3"
                            Background="#EFF6FF"
                            CornerRadius="10"
                            Padding="14">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="21"
                                                     Height="21"
                                                     Foreground="#2563EB"
                                                     Margin="0,0,10,0"/>

                            <TextBlock Text="O cliente deve ter pelo menos 14 anos e o NIF deve conter 9 dígitos."
                                       Foreground="#334155"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button x:Name="btnCancelar"
                        Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnGuardar"
                        Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>