<Window x:Class="GymManager.View.Forms.AulaForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Aula"
        Height="700"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="CalendarClock"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Nova Aula"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Registar aula, horário, professor, sala e lotação"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NOME DA AULA -->
                    <TextBox x:Name="txtNome"
                             Grid.Row="0"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome da aula"/>

                    <!-- PROFESSOR -->
                    <ComboBox x:Name="cmbProfessor"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="IdProfessor"
                              materialDesign:HintAssist.Hint="Professor"/>

                    <!-- DATA -->
                    <DatePicker x:Name="dpDataAula"
                                Grid.Row="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data da aula"/>

                    <!-- HORA -->
                    <TextBox x:Name="txtHoraInicio"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="5"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtHoraInicio_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Hora de início (HH:mm)"/>

                    <!-- DURAÇÃO -->
                    <TextBox x:Name="txtDuracao"
                             Grid.Row="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="4"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Duração em minutos"/>

                    <!-- LOTAÇÃO -->
                    <TextBox x:Name="txtLotacao"
                             Grid.Row="3"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="4"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Lotação"/>

                    <!-- SALA -->
                    <ComboBox x:Name="cmbSala"
          Grid.Row="4"
          Height="48"
          Margin="0,0,0,18"
          SelectionChanged="CamposAlterados"
          materialDesign:HintAssist.Hint="Sala">

                        <ComboBoxItem Content="Sala 1"/>
                        <ComboBoxItem Content="Sala 2"/>
                        <ComboBoxItem Content="Sala 3"/>
                        <ComboBoxItem Content="Sala 4"/>
                        <ComboBoxItem Content="Sala 5"/>

                    </ComboBox>

                    <!-- ESTADO -->
                    <ComboBox x:Name="cmbEstado"
                              Grid.Row="4"
                              Grid.Column="2"
                              Height="48"
                              Margin="0,0,0,18"
                              SelectedIndex="0"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Agendada"/>
                        <ComboBoxItem Content="Concluída"/>
                        <ComboBoxItem Content="Cancelada"/>

                    </ComboBox>

                    <!-- RESUMO -->
                    <Border Grid.Row="5"
                            Grid.ColumnSpan="3"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="#2563EB"
                                                     Margin="0,1,10,0"
                                                     VerticalAlignment="Top"/>

                            <TextBlock x:Name="txtResumo"
                                       Grid.Column="1"
                                       Text="Preencha os dados da aula. O sistema verifica conflitos de professor e sala."
                                       Foreground="#1E3A8A"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button x:Name="btnCancelar"
                        Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnGuardar"
                        Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>