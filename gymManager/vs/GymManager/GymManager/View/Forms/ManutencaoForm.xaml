<Window x:Class="GymManager.View.Forms.ManutencaoForm"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Manutenção"
         Icon="/GymManager;component/Assets/logo.ico"
        Width="760"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="WrenchClock"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Nova Manutenção"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Registar manutenção de equipamento"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- EQUIPAMENTO -->
                    <ComboBox x:Name="cmbEquipamento"
                              Grid.Row="0"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              DisplayMemberPath="DescricaoCompleta"
                              SelectedValuePath="IdEquipamento"
                              materialDesign:HintAssist.Hint="Equipamento"/>

                    <!-- TIPO -->
                    <ComboBox x:Name="cmbTipo"
                              Grid.Row="1"
                              Height="48"
                              Margin="0,0,0,18"
                              materialDesign:HintAssist.Hint="Tipo de manutenção">

                        <ComboBoxItem Content="Preventiva"/>
                        <ComboBoxItem Content="Corretiva"/>
                        <ComboBoxItem Content="Inspeção"/>

                    </ComboBox>

                    <!-- ESTADO -->
                    <ComboBox x:Name="cmbEstado"
                              Grid.Row="1"
                              Grid.Column="2"
                              Height="48"
                              Margin="0,0,0,18"
                              SelectionChanged="cmbEstado_SelectionChanged"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Agendada"/>
                        <ComboBoxItem Content="Em curso"/>
                        <ComboBoxItem Content="Concluída"/>
                        <ComboBoxItem Content="Cancelada"/>

                    </ComboBox>

                    <!-- DATA AGENDADA -->
                    <DatePicker x:Name="dpDataAgendada"
                                Grid.Row="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data agendada"/>

                    <!-- DATA REALIZAÇÃO -->
                    <DatePicker x:Name="dpDataRealizacao"
                                Grid.Row="2"
                                Grid.Column="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de realização"/>

                    <!-- RESPONSÁVEL -->
                    <TextBox x:Name="txtResponsavel"
                             Grid.Row="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Responsável"/>

                    <!-- CUSTO -->
                    <TextBox x:Name="txtCusto"
                             Grid.Row="3"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="12"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtDecimal_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Custo (€)"/>

                    <!-- DESCRIÇÃO -->
                    <TextBox x:Name="txtDescricao"
                             Grid.Row="4"
                             Grid.ColumnSpan="3"
                             Height="110"
                             Margin="0,0,0,18"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Descrição da manutenção"/>

                    <!-- OBSERVAÇÕES -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="5"
                             Grid.ColumnSpan="3"
                             Height="100"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Observações (opcional)"/>

                    <!-- NOTA -->
                    <Border Grid.Row="6"
                            Grid.ColumnSpan="3"
                            Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="10"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">

                        <TextBlock x:Name="txtNotaEstado"
                                   Text="Uma manutenção agendada deixa o equipamento em manutenção."
                                   TextWrapping="Wrap"
                                   Foreground="#1E3A8A"
                                   FontSize="12"/>

                    </Border>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>