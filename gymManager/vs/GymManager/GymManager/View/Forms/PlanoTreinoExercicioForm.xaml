<Window x:Class="GymManager.View.Forms.PlanoTreinoExercicioForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Exercício do Plano"
         Icon="/GymManager;component/Assets/logo.ico"
        Width="680"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="WeightLifter"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Adicionar Exercício"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="txtSubtitulo"
                               Text="Associar exercício ao plano de treino"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- EXERCÍCIO -->
                    <ComboBox x:Name="cmbExercicio"
                              Grid.Row="0"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="IdExercicio"
                              materialDesign:HintAssist.Hint="Exercício"/>

                    <!-- SÉRIES -->
                    <TextBox x:Name="txtSeries"
                             Grid.Row="1"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="3"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Séries"/>

                    <!-- REPETIÇÕES -->
                    <TextBox x:Name="txtRepeticoes"
                             Grid.Row="1"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="4"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Repetições"/>

                    <!-- DESCANSO -->
                    <TextBox x:Name="txtTempoDescanso"
                             Grid.Row="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="4"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Descanso em segundos"/>

                    <!-- ORDEM -->
                    <TextBox x:Name="txtOrdem"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="3"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtNumero_PreviewTextInput"
                             materialDesign:HintAssist.Hint="Ordem"/>

                    <!-- OBSERVAÇÕES -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="3"
                             Grid.ColumnSpan="3"
                             Height="120"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Observações (opcional)"/>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>
                        <TextBlock Text="Guardar"/>
                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>