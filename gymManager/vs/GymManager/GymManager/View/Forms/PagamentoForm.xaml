<Window x:Class="GymManager.View.Forms.PagamentoForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Pagamento"
         Icon="/GymManager;component/Assets/logo.ico"
        Height="800"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#15803D">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="CashRegister"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Pagamento"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Registar um pagamento do cliente"
                               FontSize="13"
                               Foreground="#DCFCE7"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <!-- Cliente -->
                        <RowDefinition Height="Auto"/>

                        <!-- Inscrição -->
                        <RowDefinition Height="Auto"/>

                        <!-- Data e valor -->
                        <RowDefinition Height="Auto"/>

                        <!-- Método e estado -->
                        <RowDefinition Height="Auto"/>

                        <!-- Cartão transferência -->
                        <RowDefinition Height="Auto"/>

                        <!-- Referências -->
                        <RowDefinition Height="Auto"/>

                        <!-- Data confirmação -->
                        <RowDefinition Height="Auto"/>

                        <!-- Aviso -->
                        <RowDefinition Height="Auto"/>

                        <!-- Observações -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AUTOCOMPLETE DO CLIENTE -->
                    <Grid Grid.Row="0"
                          Grid.ColumnSpan="3"
                          Margin="0,0,0,18">

                        <TextBox x:Name="txtCliente"
                                 Height="48"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="txtCliente_TextChanged"
                                 KeyDown="txtCliente_KeyDown"
                                 materialDesign:HintAssist.Hint="Pesquisar cliente por nome ou NIF"/>

                        <primitives:Popup x:Name="popupClientes"
                                          PlacementTarget="{Binding ElementName=txtCliente}"
                                          Placement="Bottom"
                                          StaysOpen="False"
                                          AllowsTransparency="True">

                            <Border Width="{Binding ActualWidth, ElementName=txtCliente}"
                                    MaxHeight="280"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="2"
                                                      Opacity="0.18"/>
                                </Border.Effect>

                                <ListBox x:Name="lstClientes"
                                         BorderThickness="0"
                                         MaxHeight="270"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="lstClientes_SelectionChanged"
                                         MouseDoubleClick="lstClientes_MouseDoubleClick"
                                         KeyDown="lstClientes_KeyDown">

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Grid Margin="8">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        Background="#DCFCE7">

                                                    <materialDesign:PackIcon Kind="Account"
                                                                             Width="19"
                                                                             Height="19"
                                                                             Foreground="#15803D"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>

                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0">

                                                    <TextBlock Text="{Binding Nome}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E293B"/>

                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,3,0,0">

                                                        <TextBlock Text="NIF: "
                                                                   Foreground="#64748B"/>

                                                        <TextBlock Text="{Binding NIF}"
                                                                   Foreground="#64748B"/>

                                                        <TextBlock Text="  •  Nascimento: "
                                                                   Foreground="#64748B"/>

                                                        <TextBlock Text="{Binding DataNascimento,
                                                                                StringFormat=dd/MM/yyyy}"
                                                                   Foreground="#64748B"/>

                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Border>

                        </primitives:Popup>

                    </Grid>

                    <!-- INSCRIÇÃO ATIVA -->
                    <ComboBox x:Name="cmbInscricao"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              DisplayMemberPath="Descricao"
                              SelectedValuePath="IdInscricao"
                              SelectionChanged="cmbInscricao_SelectionChanged"
                              IsEnabled="False"
                              materialDesign:HintAssist.Hint="Inscrição ativa do cliente"/>

                    <!-- DATA DO PAGAMENTO -->
                    <DatePicker x:Name="dpDataPagamento"
                                Grid.Row="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data do pagamento"/>

                    <!-- VALOR -->
                    <TextBox x:Name="txtValor"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Valor do plano (€)"/>

                    <!-- MÉTODO -->
                    <ComboBox x:Name="cmbMetodoPagamento"
                              Grid.Row="3"
                              Height="48"
                              Margin="0,0,0,18"
                              SelectionChanged="cmbMetodoPagamento_SelectionChanged"
                              materialDesign:HintAssist.Hint="Método de pagamento">

                        <ComboBoxItem Content="Dinheiro"/>
                        <ComboBoxItem Content="Transferência Bancária"/>
                        <ComboBoxItem Content="Pagamento Posterior"/>
                        <ComboBoxItem Content="MB WAY"/>
                        <ComboBoxItem Content="PayPal"/>

                    </ComboBox>

                    <!-- ESTADO -->
                    <ComboBox x:Name="cmbEstado"
                              Grid.Row="3"
                              Grid.Column="2"
                              Height="48"
                              Margin="0,0,0,18"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Pendente"/>
                        <ComboBoxItem Content="Pago"/>
                        <ComboBoxItem Content="Falhado"/>


                    </ComboBox>

                    <!-- CARTÃO DA TRANSFERÊNCIA -->
                    <Border x:Name="pnlTransferencia"
                            Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="Bank"
                                                     Width="30"
                                                     Height="30"
                                                     Foreground="#2563EB"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,14,0"/>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Dados para transferência"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1E3A8A"/>

                                <TextBlock Text="Titular"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtTitularBanco"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="IBAN"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtIBAN"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Referência interna"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtReferenciaTransferencia"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"/>

                            </StackPanel>

                            <Button Grid.Column="2"
                                    Width="95"
                                    Height="36"
                                    VerticalAlignment="Top"
                                    Click="btnCopiarIBAN_Click">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="ContentCopy"
                                                             Width="16"
                                                             Height="16"
                                                             Margin="0,0,6,0"/>

                                    <TextBlock Text="Copiar"/>

                                </StackPanel>

                            </Button>
                            <Border x:Name="pnlPayPal"
        Grid.Row="4"
        Grid.ColumnSpan="3"
        Background="#EFF6FF"
        BorderBrush="#BFDBFE"
        BorderThickness="1"
        CornerRadius="10"
        Padding="16"
        Margin="0,0,0,18"
        Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="CreditCard"
                                 Width="30"
                                 Height="30"
                                 Foreground="#1D4ED8"
                                 VerticalAlignment="Top"
                                 Margin="0,2,14,0"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Dados para pagamento PayPal"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#1E3A8A"/>

                                        <TextBlock Text="Conta"
                       FontSize="11"
                       Foreground="#64748B"
                       Margin="0,8,0,0"/>

                                        <TextBlock x:Name="txtNomePayPal"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"/>

                                        <TextBlock Text="Email PayPal"
                       FontSize="11"
                       Foreground="#64748B"
                       Margin="0,8,0,0"/>

                                        <TextBlock x:Name="txtEmailPayPal"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"/>

                                        <TextBlock Text="Referência interna"
                       FontSize="11"
                       Foreground="#64748B"
                       Margin="0,8,0,0"/>

                                        <TextBlock x:Name="txtReferenciaPayPal"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>

                                    </StackPanel>

                                    <Button Grid.Column="2"
                Width="95"
                Height="36"
                VerticalAlignment="Top"
                Click="btnPagarPayPal_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="ContentCopy"
                                         Width="16"
                                         Height="16"
                                         Margin="0,0,6,0"/>

                                            <TextBlock Text="Copiar"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Border>
                        </Grid>

                    </Border>

                    <!-- REFERÊNCIA EXTERNA -->
                    <TextBox x:Name="txtReferenciaExterna"
                             Grid.Row="5"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Referência externa"/>

                    <!-- ID DA TRANSAÇÃO -->
                    <TextBox x:Name="txtIdTransacao"
                             Grid.Row="5"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="ID da transação"/>

                    <!-- DATA DE CONFIRMAÇÃO -->
                    <DatePicker x:Name="dpDataConfirmacao"
                                Grid.Row="6"
                                Grid.ColumnSpan="3"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de confirmação"/>

                    <!-- AVISO DO MÉTODO -->
                    <Border Grid.Row="7"
                            Grid.ColumnSpan="3"
                            Background="#FEF3C7"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="21"
                                                     Height="21"
                                                     Foreground="#B45309"
                                                     Margin="0,1,10,0"
                                                     VerticalAlignment="Top"/>

                            <TextBlock x:Name="txtAvisoMetodo"
                                       Grid.Column="1"
                                       Text="Selecione um cliente, uma inscrição e o método de pagamento."
                                       Foreground="#78350F"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- OBSERVAÇÕES -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="8"
                             Grid.ColumnSpan="3"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             materialDesign:HintAssist.Hint="Observações"/>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">
                <Button x:Name="btnPagarPayPal"
        Width="155"
        Height="42"
        Margin="0,0,10,0"
        Visibility="Collapsed"
        Click="btnPagarPayPal_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentCopy"
                                 Width="18"
                                 Height="18"
                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Copiar PayPal"/>

                    </StackPanel>

                </Button>
                <Button x:Name="btnCancelar"
                        Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnGuardar"
                        Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>