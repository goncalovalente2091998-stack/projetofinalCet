<Window x:Class="GymManager.View.Forms.ReservaAulaForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nova Reserva"
         Icon="/GymManager;component/Assets/logo.ico"
        Width="620"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="AccountPlus"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Nova Reserva"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Adicionar um cliente à aula selecionada"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- INFORMAÇÃO DA AULA -->
                    <Border Grid.Row="0"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,22">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="CalendarClock"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#2563EB"
                                                 Margin="0,2,12,0"
                                                 VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1">

                                <TextBlock x:Name="txtNomeAula"
                                       Text="-"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#1E3A8A"/>

                                <TextBlock x:Name="txtDadosAula"
                                       Text="-"
                                       FontSize="13"
                                       Foreground="#475569"
                                       Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- AUTOCOMPLETE DO CLIENTE -->
                    <Grid Grid.Row="1">

                        <TextBox x:Name="txtCliente"
                             Height="48"
                             Padding="38,0,12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="txtCliente_TextChanged"
                             KeyDown="txtCliente_KeyDown"
                             materialDesign:HintAssist.Hint="Pesquisar cliente por nome ou NIF"/>

                        <materialDesign:PackIcon Kind="AccountSearch"
                                             Width="20"
                                             Height="20"
                                             Margin="11,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"
                                             IsHitTestVisible="False"/>

                        <Popup x:Name="popupClientes"
                           PlacementTarget="{Binding ElementName=txtCliente}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">

                            <Border Width="{Binding ActualWidth, ElementName=txtCliente}"
                                MaxHeight="220"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">

                                <ListBox x:Name="lstClientes"
                                     DisplayMemberPath="DescricaoReserva"
                                     SelectionChanged="lstClientes_SelectionChanged"
                                     MouseDoubleClick="lstClientes_MouseDoubleClick"
                                     KeyDown="lstClientes_KeyDown"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                            </Border>

                        </Popup>

                    </Grid>

                    <!-- CLIENTE SELECIONADO -->
                    <Border Grid.Row="2"
                        x:Name="pnlClienteSelecionado"
                        Background="#ECFDF5"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,18,0,0"
                        Visibility="Collapsed">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="AccountCheck"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="#15803D"
                                                 Margin="0,1,10,0"/>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Cliente selecionado"
                                       FontSize="11"
                                       Foreground="#15803D"/>

                                <TextBlock x:Name="txtClienteSelecionado"
                                       Text="-"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#166534"/>

                                <TextBlock x:Name="txtNifSelecionado"
                                       Text="-"
                                       FontSize="12"
                                       Foreground="#475569"
                                       Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>