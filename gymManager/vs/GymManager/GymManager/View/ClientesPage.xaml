<Page x:Class="GymManager.View.ClientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Clientes">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

            <Button x:Name="btnNovo"
                    Content="➕ Novo"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0" Click="btnNovo_Click"/>

            <Button x:Name="btnEditar"
                    Content="✏️ Editar"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0" Click="btnEditar_Click"/>

            <Button x:Name="btnEliminar"
                    Content="🗑️ Eliminar"
                    Width="120"
                    Height="35"
                    Margin="0,0,20,0" Click="btnEliminar_Click"/>

            <Grid Width="280" Height="40">

                <TextBox x:Name="txtPesquisar"
             Padding="35,0,10,0"
             materialDesign:HintAssist.Hint="Pesquisar professor..."
             materialDesign:TextFieldAssist.HasClearButton="True"
             TextChanged="txtPesquisar_TextChanged"/>

                <materialDesign:PackIcon Kind="Magnify"
                             Width="20"
                             Height="20"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Foreground="Gray"/>

            </Grid>

        </StackPanel>

        <DataGrid x:Name="dgClientes"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding IdCliente}"
                                    Width="60"/>

                <DataGridTextColumn Header="Nome"
                                    Binding="{Binding Nome}"
                                    Width="220"/>

                <DataGridTextColumn Header="NIF"
                                    Binding="{Binding NIF}"
                                    Width="120"/>

                <DataGridTextColumn Header="Telefone"
                                    Binding="{Binding Telefone}"
                                    Width="120"/>

                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="220"/>

                <DataGridCheckBoxColumn Header="Ativo"
                                        Binding="{Binding Estado}"
                                        Width="80"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Page>