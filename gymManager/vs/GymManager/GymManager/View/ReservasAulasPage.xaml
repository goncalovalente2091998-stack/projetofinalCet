<Page x:Class="GymManager.View.ReservasAulasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Reservas da Aula"
      Language="pt-PT"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <Button Width="110"
                        Height="36"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="btnVoltar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Voltar"/>

                    </StackPanel>

                </Button>

                <TextBlock x:Name="txtTitulo"
                           Text="Reservas da Aula"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão dos clientes inscritos nesta aula"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    VerticalAlignment="Bottom">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="27"
                                             Height="27"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total de reservas"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalReservas"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- INFORMAÇÃO DA AULA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20"
                Margin="0,25,0,18"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- AULA -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Aula"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="txtNomeAula"
                               Text="-"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="txtProfessor"
                               Text="-"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <!-- DATA/HORA -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Data e hora"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="txtDataHora"
                               Text="-"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"/>

                    <TextBlock x:Name="txtSala"
                               Text="-"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <!-- RESERVADAS -->
                <Border Grid.Column="4"
                        Background="#EFF6FF"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="Reservadas"
                                   FontSize="12"
                                   Foreground="#1D4ED8"/>

                        <TextBlock x:Name="txtReservadas"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1D4ED8"/>

                    </StackPanel>

                </Border>

                <!-- LIVRES -->
                <Border Grid.Column="6"
                        Background="#ECFDF5"
                        CornerRadius="10"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="Vagas livres"
                                   FontSize="12"
                                   Foreground="#15803D"/>

                        <TextBlock x:Name="txtLivres"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#15803D"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- BARRA DE AÇÕES -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,18"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           Margin="0,0,0,14">

                    <Button x:Name="btnNovaReserva"
                            Width="145"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnNovaReserva_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="AccountPlus"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Nova Reserva"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnCancelarReserva"
                            Width="145"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnCancelarReserva_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Cancel"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Cancelar"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnPresente"
                            Width="130"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnPresente_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="CheckCircle"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Presente"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnFaltou"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="btnFaltou_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="AccountOff"
                                                     Width="18"
                                                     Height="18"/>

                            <TextBlock Text="Faltou"
                                       Margin="8,0,0,0"/>

                        </StackPanel>

                    </Button>

                </WrapPanel>

                <Grid Grid.Row="1"
                      Width="520"
                      Height="42"
                      HorizontalAlignment="Left">

                    <TextBox x:Name="txtPesquisar"
                             Padding="38,0,35,0"
                             VerticalContentAlignment="Center"
                             TextChanged="txtPesquisar_TextChanged"
                             materialDesign:HintAssist.Hint="Pesquisar por cliente, NIF ou estado..."
                             materialDesign:TextFieldAssist.HasClearButton="True"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="10,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"
                                             IsHitTestVisible="False"/>

                </Grid>

            </Grid>

        </Border>

        <!-- TABELA -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="dgReservas"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="44"
                      ColumnHeaderHeight="44"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NomeCliente}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="NIF"
                                        Binding="{Binding NIF}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Data da reserva"
                                        Binding="{Binding DataReserva,
                                                          StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="165"/>

                    <DataGridTemplateColumn Header="Estado"
                                            Width="130">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="9,4"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background"
                                                    Value="#E2E8F0"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Confirmada">
                                                    <Setter Property="Background"
                                                            Value="#DBEAFE"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Presente">
                                                    <Setter Property="Background"
                                                            Value="#DCFCE7"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Faltou">
                                                    <Setter Property="Background"
                                                            Value="#FEF3C7"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Cancelada">
                                                    <Setter Property="Background"
                                                            Value="#FEE2E2"/>
                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding Estado}"
                                               FontSize="12"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Foreground"
                                                        Value="#475569"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Confirmada">
                                                        <Setter Property="Foreground"
                                                                Value="#1D4ED8"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Presente">
                                                        <Setter Property="Foreground"
                                                                Value="#15803D"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Faltou">
                                                        <Setter Property="Foreground"
                                                                Value="#B45309"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="Cancelada">
                                                        <Setter Property="Foreground"
                                                                Value="#B91C1C"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>