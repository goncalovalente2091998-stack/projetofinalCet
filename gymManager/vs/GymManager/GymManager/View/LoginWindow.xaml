<Window x:Class="GymManager.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Manager — Iniciar Sessão"
         Icon="/GymManager;component/Assets/logo.ico"
        Height="620"
        Width="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="BotaoPrincipal"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#1E40AF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- TEXTBOX -->
        <Style x:Key="CampoTexto"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                                <Setter TargetName="border"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#60A5FA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- PASSWORDBOX -->
        <Style x:Key="CampoPassword"
               TargetType="PasswordBox">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="#0F172A"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                                <Setter TargetName="border"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#60A5FA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PAINEL ESQUERDO -->
        <Border Grid.Column="0">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#1D4ED8"
                                  Offset="0"/>

                    <GradientStop Color="#0F172A"
                                  Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

            <Grid Margin="38">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <Border Width="88"
                            Height="88"
                            CornerRadius="24"
                            Background="#20FFFFFF"
                            HorizontalAlignment="Left">

                        <TextBlock Text="GYM"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="GYM MANAGER"
                               Margin="0,25,0,0"
                               FontSize="31"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Sistema de gestão de ginásio"
                               Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="#BFDBFE"/>

                    <Border Margin="0,35,0,0"
                            Height="1"
                            Background="#35FFFFFF"/>

                    <TextBlock Margin="0,30,0,0"
                               Text="Gestão simples, rápida e organizada."
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,10,0,0"
                               Text="Acede aos clientes, planos de treino, avaliações físicas, equipamentos e presenças."
                               FontSize="13"
                               Foreground="#CBD5E1"
                               LineHeight="21"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="© 2026 Gym Manager"
                           Foreground="#94A3B8"
                           FontSize="11"/>

            </Grid>

        </Border>

        <!-- ÁREA DO LOGIN -->
        <Grid Grid.Column="1"
              Background="#F1F5F9">

            <Border Width="430"
                    Padding="42"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="8"
                                      Opacity="0.14"
                                      Color="#0F172A"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Bem-vindo"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Introduza as suas credenciais para continuar."
                               Margin="0,7,0,32"
                               FontSize="13"
                               Foreground="#64748B"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email"
                               Margin="0,0,0,7"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource CampoTexto}"
                             Margin="0,0,0,20"
                             Text="admin@gym.pt"/>

                    <!-- PASSWORD -->
                    <TextBlock Text="Palavra-passe"
                               Margin="0,0,0,7"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <PasswordBox x:Name="txtPassword"
                                 Style="{StaticResource CampoPassword}"
                                 Margin="0,0,0,12"/>

                    <TextBlock Text="Utilize as credenciais associadas à sua conta."
                               Margin="2,0,0,28"
                               FontSize="11"
                               Foreground="#94A3B8"/>

                    <!-- BOTÃO -->
                    <Button x:Name="btnEntrar"
                            Content="Entrar"
                            Style="{StaticResource BotaoPrincipal}"
                            Click="btnEntrar_Click"
                            IsDefault="True"/>

                    <Border Margin="0,28,0,0"
                            Height="1"
                            Background="#E2E8F0"/>

                    <TextBlock Text="Acesso reservado a utilizadores autorizados."
                               Margin="0,18,0,0"
                               FontSize="11"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>