<Page x:Class="GymManager.View.PlanosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Planos"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Planos de Adesão"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão dos planos disponíveis no ginásio"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="CardAccountDetails"
                                             Width="26"
                                             Height="26"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total de Planos"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalPlanos"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,25,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnNovo"
                        Width="160"
                        Height="42"
                        Click="btnNovo_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Plus"
                                                 Width="19"
                                                 Height="19"
                                                 Margin="0,0,8,0"/>

                        <TextBlock Text="Novo Plano"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Grid Grid.Column="2"
                      Height="42">

                    <TextBox x:Name="txtPesquisar"
                             Padding="38,0,35,0"
                             VerticalContentAlignment="Center"
                             TextChanged="txtPesquisar_TextChanged"
                             materialDesign:HintAssist.Hint="Pesquisar plano..."
                             materialDesign:TextFieldAssist.HasClearButton="True"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="10,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"/>

                </Grid>

            </Grid>

        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="icPlanos"
                          HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <WrapPanel HorizontalAlignment="Center"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="275"
                                MinHeight="340"
                                Margin="0,0,16,20"
                                Padding="22"
                                Background="White"
                                CornerRadius="16"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.12"/>

                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Width="62"
                                        Height="62"
                                        CornerRadius="31"
                                        Background="#DBEAFE"
                                        HorizontalAlignment="Center">

                                    <materialDesign:PackIcon Kind="CardMembership"
                                                             Width="32"
                                                             Height="32"
                                                             Foreground="#2563EB"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Row="1"
                                            Margin="0,15,0,0">

                                    <TextBlock Text="{Binding Nome}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,12,0,0">

                                        <TextBlock Text="{Binding Preco, StringFormat={}{0:F2} €}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#2563EB"/>

                                    </StackPanel>

                                    <TextBlock Text="{Binding DuracaoMeses, StringFormat={}{0} meses}"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <Separator Grid.Row="2"
                                           Margin="0,18,0,14"/>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding Descricao}"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Top"/>

                                <Grid Grid.Row="4"
                                      Margin="0,20,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Height="40"
                                            Tag="{Binding}"
                                            Click="btnEditarCard_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="17"
                                                                     Height="17"
                                                                     Margin="0,0,7,0"/>

                                            <TextBlock Text="Editar"/>

                                        </StackPanel>

                                    </Button>

                                    <Button Grid.Column="2"
                                            Height="40"
                                            Tag="{Binding}"
                                            Click="btnEliminarCard_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Delete"
                                                                     Width="17"
                                                                     Height="17"
                                                                     Margin="0,0,7,0"/>

                                            <TextBlock Text="Eliminar"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>