<Page x:Class="GymManager.View.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Dashboard"
      Language="pt-PT"
      Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="25">

            <Grid.RowDefinitions>
                <!-- Cabecalho -->
                <RowDefinition Height="Auto"/>

                <!-- Primeira linha de cartoes -->
                <RowDefinition Height="Auto"/>

                <!-- Segunda linha de cartoes -->
                <RowDefinition Height="Auto"/>

                <!-- Terceira linha de cartoes -->
                <RowDefinition Height="Auto"/>

                <!-- Tabelas -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Dashboard"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="Resumo geral da atividade do ginásio"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Button x:Name="btnAtualizar"
                        Grid.Column="1"
                        Width="125"
                        Height="42"
                        VerticalAlignment="Center"
                        Click="btnAtualizar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Atualizar"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

            <!-- Primeira linha -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- clientes ativos -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DBEAFE">

                            <materialDesign:PackIcon Kind="AccountGroup"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#2563EB"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Clientes ativos"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtClientesAtivos"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- inscricoes ativas -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DCFCE7">

                            <materialDesign:PackIcon Kind="FileCheck"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#15803D"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Inscrições ativas"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtInscricoesAtivas"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Pagamentos pendentes -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#FEF3C7">

                            <materialDesign:PackIcon Kind="ClockOutline"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#B45309"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Pagamentos pendentes"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtPagamentosPendentes"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <!-- Segunda linha -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Receita do  mes -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DCFCE7">

                            <materialDesign:PackIcon Kind="CashMultiple"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#15803D"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Receita do mês"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtReceitaMes"
                                       Text="0,00 €"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- receita do ano-->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DBEAFE">

                            <materialDesign:PackIcon Kind="Calendar"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#2563EB"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Receita do ano"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtReceitaAno"
                                       Text="0,00 €"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- Receita  total -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#EDE9FE">

                            <materialDesign:PackIcon Kind="CurrencyEur"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#7C3AED"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Receita total"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtReceitaTotal"
                                       Text="0,00 €"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <!-- terceira linha -->
            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- aulas de hoje -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DBEAFE">

                            <materialDesign:PackIcon Kind="CalendarToday"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#2563EB"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Aulas de hoje"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtAulasHoje"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- reservas de hoje -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#DCFCE7">

                            <materialDesign:PackIcon Kind="AccountCheck"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#15803D"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Reservas de hoje"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtReservasHoje"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- inscricoes a terminar -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="14"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="#FEE2E2">

                            <materialDesign:PackIcon Kind="CalendarAlert"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="#B91C1C"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Inscrições a terminar"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="txtInscricoesATerminar"
                                       Text="0"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Próximos 7 dias"
                                       FontSize="11"
                                       Foreground="#94A3B8"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <!-- tabelas -->
            <Grid Grid.Row="4"
                  Margin="0,22,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ultimos pagamentos-->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="18"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Últimos pagamentos"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Os cinco pagamentos mais recentes"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <DataGrid x:Name="dgUltimosPagamentos"
                                  Grid.Row="1"
                                  Height="250"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="40"
                                  ColumnHeaderHeight="40"
                                  BorderThickness="0"
                                  AlternatingRowBackground="#F8FAFC">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Cliente"
                                                    Binding="{Binding NomeCliente}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Plano"
                                                    Binding="{Binding NomePlano}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Data"
                                                    Binding="{Binding DataPagamento,
                                                                      StringFormat=dd/MM/yyyy}"
                                                    Width="95"/>

                                <DataGridTextColumn Header="Valor"
                                                    Binding="{Binding Valor,
                                                                      StringFormat={}{0:N2} €}"
                                                    Width="100"/>

                                <DataGridTemplateColumn Header="Estado"
                                                        Width="105">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Padding="8,3"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Center">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background"
                                                                Value="#FEE2E2"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding Estado}"
                                                                         Value="Pago">

                                                                <Setter Property="Background"
                                                                        Value="#DCFCE7"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Estado}"
                                                                         Value="Pendente">

                                                                <Setter Property="Background"
                                                                        Value="#FEF3C7"/>

                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Estado}"
                                                                         Value="Reembolsado">

                                                                <Setter Property="Background"
                                                                        Value="#DBEAFE"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <TextBlock Text="{Binding Estado}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Foreground"
                                                                    Value="#B91C1C"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding Estado}"
                                                                             Value="Pago">

                                                                    <Setter Property="Foreground"
                                                                            Value="#15803D"/>

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Estado}"
                                                                             Value="Pendente">

                                                                    <Setter Property="Foreground"
                                                                            Value="#B45309"/>

                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Estado}"
                                                                             Value="Reembolsado">

                                                                    <Setter Property="Foreground"
                                                                            Value="#1D4ED8"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- inscricoes a terminar -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="18"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Inscrições a terminar"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>

                            <TextBlock Text="Inscrições que terminam nos próximos 7 dias"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <DataGrid x:Name="dgInscricoesATerminar"
                                  Grid.Row="1"
                                  Height="250"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="40"
                                  ColumnHeaderHeight="40"
                                  BorderThickness="0"
                                  AlternatingRowBackground="#F8FAFC">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Cliente"
                                                    Binding="{Binding NomeCliente}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Plano"
                                                    Binding="{Binding NomePlano}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Data final"
                                                    Binding="{Binding DataFim,
                                                                      StringFormat=dd/MM/yyyy}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="Dias"
                                                    Binding="{Binding DiasRestantes}"
                                                    Width="65"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>