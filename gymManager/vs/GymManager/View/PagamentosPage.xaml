<Page x:Class="GymManager.View.PagamentosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Pagamentos"
      Language="pt-PT"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Gestão de Pagamentos"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Registo e acompanhamento dos pagamentos do ginásio"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button x:Name="btnNovo"
                    Grid.Column="1"
                    Width="170"
                    Height="42"
                    VerticalAlignment="Center"
                    Click="btnNovo_Click">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="CashPlus"
                                             Width="19"
                                             Height="19"
                                             Margin="0,0,8,0"/>

                    <TextBlock Text="Novo Pagamento"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

        <!-- Estatisticas -->
        <Grid Grid.Row="1"
              Margin="0,25,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Receita -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <Border Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="#DCFCE7">

                        <materialDesign:PackIcon Kind="CurrencyEur"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="#15803D"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Receita total"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtReceitaTotal"
                                   Text="0,00 €"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Pagos -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <Border Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="#DCFCE7">

                        <materialDesign:PackIcon Kind="CheckCircle"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="#15803D"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Pagos"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalPagos"
                                   Text="0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Pendentes -->
            <Border Grid.Column="4"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <Border Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="#FEF3C7">

                        <materialDesign:PackIcon Kind="ClockOutline"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="#B45309"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Pendentes"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalPendentes"
                                   Text="0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Falhados -->
            <Border Grid.Column="6"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel Orientation="Horizontal">

                    <Border Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="#FEE2E2">

                        <materialDesign:PackIcon Kind="CloseCircle"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="#B91C1C"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Falhados"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalFalhados"
                                   Text="0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- barra de acoes -->

        <Border Grid.Row="2"
        Background="White"
        CornerRadius="12"
        Padding="15"
        Margin="0,0,0,20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- botoes -->

                <WrapPanel Grid.Row="0">

                    <Button x:Name="btnEditar"
                    Width="120"
                    Height="42"
                    Margin="0,0,10,10"
                    Click="btnEditar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Pencil"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"/>

                            <TextBlock Text="Editar"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnConfirmar"
                    Width="130"
                    Height="42"
                    Margin="0,0,10,10"
                    Click="btnConfirmar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="CheckCircle"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"/>

                            <TextBlock Text="Confirmar"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnReembolsar"
                    Width="135"
                    Height="42"
                    Margin="0,0,10,10"
                    Click="btnReembolsar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="CashRefund"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"/>

                            <TextBlock Text="Reembolsar"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnEliminar"
                    Width="120"
                    Height="42"
                    Margin="0,0,10,10"
                    Click="btnEliminar_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Delete"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,7,0"/>

                            <TextBlock Text="Eliminar"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnExportarPdf"
                     Width="120"
                     Height="42"
                     Margin="0,0,10,10"
                     Click="BtnExportarPdf_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="FilePdfBox"
                                 Width="18"
                                 Height="18"
                                 Margin="0,0,7,0"/>

                            <TextBlock Text="PDF"/>

                        </StackPanel>

                    </Button>
                </WrapPanel>

                <!-- Pesquisa -->

                <Grid Grid.Row="1"
                 Width="520"
                 Height="42"
                 Margin="0,16,0,0"
                 HorizontalAlignment="Left">

                    <TextBox x:Name="txtPesquisar"
                     Padding="38,0,35,0"
                     VerticalContentAlignment="Center"
                     TextChanged="txtPesquisar_TextChanged"
                     materialDesign:HintAssist.Hint="Pesquisar por cliente ou data..."
                     materialDesign:TextFieldAssist.HasClearButton="True"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                     Width="20"
                                     Height="20"
                                     Margin="10,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Foreground="#64748B"
                                     IsHitTestVisible="False"/>

                </Grid>

            </Grid>

        </Border>

        <!-- tabela -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="dgPagamentos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="44"
                      ColumnHeaderHeight="44"
                      BorderThickness="0"
                      AlternatingRowBackground="#F8FAFC">

                <DataGrid.Columns>

               
                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NomeCliente}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Plano"
                                        Binding="{Binding NomePlano}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Referência"
                                        Binding="{Binding  ReferenciaInscricao}"
                                        Width="220"/>
                    <DataGridTextColumn Header="Data"
                                        Binding="{Binding DataPagamento,
                                                          StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Valor"
                                        Binding="{Binding Valor,
                                                          StringFormat={}{0:N2} €}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Método"
                                        Binding="{Binding MetodoPagamento}"
                                        Width="150"/>
                    <DataGridTemplateColumn Header="Estado"
                                        Width="120">

                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment"
                                    Value="Center"/>
                                <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch">

                                    <Border Padding="9,4"
                                         CornerRadius="10"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <!-- Falhado por defeito -->
                                                <Setter Property="Background"
                                                  Value="#FEE2E2"/>
    
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                          Value="Pago">
                                                        <Setter Property="Background"
                                                             Value="#DCFCE7"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                           Value="Pendente">
                                                        <Setter Property="Background"
                                                           Value="#FEF3C7"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                          Value="Reembolsado">
                                                        <Setter Property="Background"
                                                             Value="#DBEAFE"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                           Value="Falhado">
                                                        <Setter Property="Background"
                                                          Value="#FEE2E2"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock Text="{Binding Estado}"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextAlignment="Center">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <!-- Falhado por defeito -->
                                                    <Setter Property="Foreground"
                                                      Value="#B91C1C"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Estado}"
                                                             Value="Pago">
                                                            <Setter Property="Foreground"
                                                              Value="#15803D"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Estado}"
                                                             Value="Pendente">
                                                            <Setter Property="Foreground"
                                                              Value="#B45309"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Estado}"
                                                           Value="Reembolsado">
                                                            <Setter Property="Foreground"
                                                                  Value="#1D4ED8"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Estado}"
                                                               Value="Falhado">
                                                            <Setter Property="Foreground"
                                                              Value="#B91C1C"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </Grid>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Referência"
                                        Binding="{Binding ReferenciaExterna}"
                                        Width="170"/>

                    <DataGridTextColumn Header="Observações"
                                        Binding="{Binding Observacoes}"
                                        Width="2*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>