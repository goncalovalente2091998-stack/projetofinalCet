<Page x:Class="GymManager.View.PersonalTrainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Personal Trainers"
      Background="#F5F7FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Personal Trainers"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="Gestão dos treinadores e acompanhamento personalizado"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="26"
                                             Height="26"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total de PT"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotalPT"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Barra de ferramentas -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,25,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnNovo"
                        Width="200"
                        Height="42"
                        Click="btnNovo_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Plus"
                                                 Width="19"
                                                 Height="19"
                                                 Margin="0,0,8,0"/>

                        <TextBlock Text="Novo Personal Trainer"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- Pesquisa -->
                <Grid Grid.Column="2"
                      Height="42">

                    <TextBox x:Name="txtPesquisar"
                             Padding="38,0,35,0"
                             VerticalContentAlignment="Center"
                             TextChanged="txtPesquisar_TextChanged"
                             materialDesign:HintAssist.Hint="Pesquisar Personal Trainer..."
                             materialDesign:TextFieldAssist.HasClearButton="True"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20"
                                             Height="20"
                                             Margin="10,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Foreground="#64748B"/>

                </Grid>

            </Grid>

        </Border>

        <!-- cards -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="icPersonalTrainers">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="275"
                                MinHeight="330"
                                Margin="0,0,18,18"
                                Padding="20"
                                Background="White"
                                CornerRadius="15"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.12"/>

                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- avatar e estado -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="72"
                                            Height="72"
                                            CornerRadius="36"
                                            Background="#DBEAFE"
                                            HorizontalAlignment="Left">

                                        <materialDesign:PackIcon Kind="AccountTie"
                                                                 Width="38"
                                                                 Height="38"
                                                                 Foreground="#2563EB"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>

                                    </Border>

                                    <Border Grid.Column="1"
                                            Padding="10,5"
                                            CornerRadius="12"
                                            VerticalAlignment="Top">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#FEE2E2"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Estado}"
                                                                 Value="True">

                                                        <Setter Property="Background"
                                                                Value="#DCFCE7"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                            Value="Inativo"/>

                                                    <Setter Property="Foreground"
                                                            Value="#B91C1C"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Estado}"
                                                                     Value="True">

                                                            <Setter Property="Text"
                                                                    Value="Ativo"/>

                                                            <Setter Property="Foreground"
                                                                    Value="#15803D"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </Grid>

                                <!-- nome -->
                                <StackPanel Grid.Row="1"
                                            Margin="0,15,0,0">

                                    <TextBlock Text="{Binding Nome}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Especialidade}"
                                               FontSize="14"
                                               Foreground="#64748B"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <Separator Grid.Row="2"
                                           Margin="0,15,0,12"/>

                                <!-- Contactos -->
                                <StackPanel Grid.Row="3">

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,10">

                                        <materialDesign:PackIcon Kind="Phone"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#64748B"/>

                                        <TextBlock Text="{Binding Telefone}"
                                                   Margin="9,0,0,0"
                                                   Foreground="#334155"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <materialDesign:PackIcon Kind="Email"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#64748B"/>

                                        <TextBlock Text="{Binding Email}"
                                                   Margin="9,0,0,0"
                                                   Foreground="#334155"
                                                   MaxWidth="195"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </StackPanel>

                                <!-- valor -->
                                <Border Grid.Row="4"
                                        Background="#EFF6FF"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,18,0,18"
                                        VerticalAlignment="Top">

                                    <StackPanel Orientation="Horizontal">

                                        <materialDesign:PackIcon Kind="CurrencyEur"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="#2563EB"/>

                                        <TextBlock Text="{Binding ValorHora, StringFormat={}{0:F2} € / hora}"
                                                   Margin="8,0,0,0"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#2563EB"/>

                                    </StackPanel>

                                </Border>

                                <!-- Botoes Card -->
                                <Grid Grid.Row="5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Height="40"
                                            Tag="{Binding}"
                                            Click="btnEditarCard_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="17"
                                                                     Height="17"
                                                                     Margin="0,0,7,0"/>

                                            <TextBlock Text="Editar"/>

                                        </StackPanel>

                                    </Button>

                                    <Button Grid.Column="2"
                                            Height="40"
                                            Tag="{Binding}"
                                            Click="btnEliminarCard_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Delete"
                                                                     Width="17"
                                                                     Height="17"
                                                                     Margin="0,0,7,0"/>

                                            <TextBlock Text="Eliminar"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>