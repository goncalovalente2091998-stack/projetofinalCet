<Page x:Class="GymManager.View.PlanoTreinoExerciciosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Exercícios do Plano"
      Language="pt-PT"
      Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- cabecalho -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <Button Width="110"
                        Height="36"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="btnVoltar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Voltar"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <TextBlock x:Name="txtTitulo"
                           Text="Exercícios do Plano"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock x:Name="txtSubtitulo"
                           Text="-"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18,10"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    VerticalAlignment="Bottom">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="WeightLifter"
                                             Width="27"
                                             Height="27"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center"/>

                    <StackPanel Margin="10,0,0,0">

                        <TextBlock Text="Total"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- barra de acoes -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,25,0,20"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <WrapPanel>

                <Button x:Name="btnAdicionar"
                        Width="145"
                        Height="42"
                        Margin="0,0,10,10"
                        Click="btnAdicionar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Plus"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Text="Adicionar"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnEditar"
                        Width="120"
                        Height="42"
                        Margin="0,0,10,10"
                        Click="btnEditar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Pencil"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Text="Editar"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnRemover"
                        Width="120"
                        Height="42"
                        Margin="0,0,10,10"
                        Click="btnRemover_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Delete"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Text="Remover"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnSubir"
                        Width="110"
                        Height="42"
                        Margin="0,0,10,10"
                        Click="btnSubir_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ArrowUp"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Text="Subir"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnDescer"
                        Width="110"
                        Height="42"
                        Margin="0,0,10,10"
                        Click="btnDescer_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ArrowDown"
                                                 Width="18"
                                                 Height="18"/>

                        <TextBlock Text="Descer"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </WrapPanel>

        </Border>

        <!-- tabela -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <DataGrid x:Name="dgExerciciosPlano"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFC"
                      RowHeight="44"
                      ColumnHeaderHeight="44"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Ordem"
                                        Binding="{Binding Ordem}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Exercício"
                                        Binding="{Binding NomeExercicio}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Grupo muscular"
                                        Binding="{Binding GrupoMuscular}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Séries"
                                        Binding="{Binding Series}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Repetições"
                                        Binding="{Binding Repeticoes}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Descanso"
                                        Binding="{Binding DescansoFormatado}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Observações"
                                        Binding="{Binding Observacoes}"
                                        Width="2*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>