<Window x:Class="GymManager.View.Forms.PlanoTreinoForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Plano de Treino"
        Icon="/GymManager;component/Assets/logo.ico"
        Width="720"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- cabecalho -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="ClipboardText"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Plano de Treino"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Associar cliente, personal trainer e objetivo"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Conteudo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nome -->
                    <TextBox x:Name="txtNomePlano"
                             Grid.Row="0"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome do plano"/>

                    <ComboBox x:Name="cmbCliente"
                            Grid.Row="1"
                            Height="48"
                            Margin="0,0,0,18"
                            DisplayMemberPath="DescricaoReserva"
                            SelectedValuePath="IdCliente"
                            IsEditable="True"
                            StaysOpenOnEdit="True"
                            IsTextSearchEnabled="False"
                            Loaded="cmbCliente_Loaded"
                            materialDesign:HintAssist.Hint="Cliente"/>
                    <!-- Personal Trainer -->
                    <ComboBox x:Name="cmbPT"
                              Grid.Row="1"
                              Grid.Column="2"
                              Height="48"
                              Margin="0,0,0,18"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="IdPT"
                              materialDesign:HintAssist.Hint="Personal trainer"/>

                    <!-- Data Inicio -->
                    <DatePicker x:Name="dpDataInicio"
                                Grid.Row="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de início"/>

                    <!-- Data fim -->
                    <DatePicker x:Name="dpDataFim"
                                Grid.Row="2"
                                Grid.Column="2"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de fim"/>

                    <!-- Estado -->
                    <ComboBox x:Name="cmbEstado"
                              Grid.Row="3"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              SelectedIndex="0"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Concluído"/>
                        <ComboBoxItem Content="Cancelado"/>

                    </ComboBox>

                    <!-- Objetivo -->
                    <TextBox x:Name="txtObjetivo"
                             Grid.Row="4"
                             Grid.ColumnSpan="3"
                             Height="90"
                             Margin="0,0,0,18"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Objetivo do plano"/>

                    <!-- Observacoes -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="5"
                             Grid.ColumnSpan="3"
                             Height="100"
                             MaxLength="255"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Observações (opcional)"/>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- Rodape -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>