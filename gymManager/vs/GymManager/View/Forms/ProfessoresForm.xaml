<Window x:Class="GymManager.View.Forms.ProfessoresForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Professor"
        Icon="/GymManager;component/Assets/logo.ico"
        Height="540"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Border Grid.Row="0"
                Background="#7C3AED">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="School"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Professor"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Dados pessoais e área de especialidade"
                               FontSize="13"
                               Foreground="#EDE9FE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Conteudo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtNome"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome completo"/>

                    <TextBox x:Name="txtEspecialidade"
                             Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Especialidade"/>

                    <TextBox x:Name="txtTelefone"
                             Grid.Row="2"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Telefone"/>

                    <TextBox x:Name="txtEmail"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Email"/>

                    <Border Grid.Row="3"
                            Grid.ColumnSpan="3"
                            Background="#F5F3FF"
                            CornerRadius="10"
                            Padding="14">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="21"
                                                     Height="21"
                                                     Foreground="#7C3AED"
                                                     Margin="0,0,10,0"/>

                            <TextBlock Text="Confirme que o telefone e o email estão corretos antes de guardar."
                                       Foreground="#334155"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- Rodape -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button x:Name="btnCancelar"
                        Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click_1">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button x:Name="btnGuardar"
                        Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>