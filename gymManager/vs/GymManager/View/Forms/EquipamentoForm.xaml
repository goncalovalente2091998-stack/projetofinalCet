<Window x:Class="GymManager.View.Forms.EquipamentoForm"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         Title="Equipamento"
         Icon="/GymManager;component/Assets/logo.ico"
         Width="740"
         Height="720"
         WindowStartupLocation="CenterOwner"
         ResizeMode="NoResize"
         Background="#F1F5F9"
         Language="pt-PT">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- cabecalho -->
        <Border Grid.Row="0"
                Background="#2563EB">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="Tools"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Equipamento"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="txtSubtitulo"
                               Text="Registar equipamento no inventário"
                               FontSize="13"
                               Foreground="#DBEAFE"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Conteudo -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- nome -->
                    <TextBox x:Name="txtNome"
                             Grid.Row="0"
                             Grid.ColumnSpan="3"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome do equipamento"/>

                    <!-- categoria -->
                    <ComboBox x:Name="cmbCategoria"
                              Grid.Row="1"
                              Height="48"
                              Margin="0,0,0,18"
                              materialDesign:HintAssist.Hint="Categoria">

                        <ComboBoxItem Content="Cardio"/>
                        <ComboBoxItem Content="Musculação"/>
                        <ComboBoxItem Content="Peso livre"/>
                        <ComboBoxItem Content="Funcional"/>
                        <ComboBoxItem Content="Acessório"/>
                        <ComboBoxItem Content="Outro"/>

                    </ComboBox>

                    <!-- marca -->
                    <TextBox x:Name="txtMarca"
                             Grid.Row="1"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Marca"/>

                    <!-- modelo -->
                    <TextBox x:Name="txtModelo"
                             Grid.Row="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="50"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Modelo (opcional)"/>

                    <!-- Numero de serie -->
                    <TextBox x:Name="txtNumeroSerie"
                             Grid.Row="2"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Número de série (opcional)"/>

                    <!-- Data de aquisicao -->
                    <DatePicker x:Name="dpDataAquisicao"
                                Grid.Row="3"
                                Height="48"
                                Margin="0,0,0,18"
                                materialDesign:HintAssist.Hint="Data de aquisição"/>

                    <!-- lcoalizacao -->
                    <TextBox x:Name="txtLocalizacao"
                             Grid.Row="3"
                             Grid.Column="2"
                             Height="48"
                             Margin="0,0,0,18"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Localização"/>

                    <!-- estado -->
                    <ComboBox x:Name="cmbEstado"
                              Grid.Row="4"
                              Grid.ColumnSpan="3"
                              Height="48"
                              Margin="0,0,0,18"
                              SelectionChanged="cmbEstado_SelectionChanged"
                              materialDesign:HintAssist.Hint="Estado">

                        <ComboBoxItem Content="Operacional"/>
                        <ComboBoxItem Content="Em manutenção"/>
                        <ComboBoxItem Content="Fora de serviço"/>
                        <ComboBoxItem Content="Abatido"/>

                    </ComboBox>

                    <!-- Aviso de manutencao -->
                    <Border x:Name="borderAvisoManutencao"
                            Grid.Row="5"
                            Grid.ColumnSpan="3"
                            Background="#FEF3C7"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="24"
                                                     Height="24"
                                                     Foreground="#B45309"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Top"/>

                            <TextBlock Text="Ao guardar, será criada automaticamente uma manutenção agendada.&#10;Depois deverá abrir o módulo Manutenções e atribuir o responsável."
                                       TextWrapping="Wrap"
                                       Foreground="#92400E"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>

                    <!--observacoes -->
                    <TextBox x:Name="txtObservacoes"
                             Grid.Row="6"
                             Grid.ColumnSpan="3"
                             Height="130"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Observações (opcional)"/>

                </Grid>

            </Border>

        </ScrollViewer>

        <!-- Rodape -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button Width="125"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Cancelar"/>

                    </StackPanel>

                </Button>

                <Button Width="125"
                        Height="42"
                        Click="btnGuardar_Click">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSave"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,7,0"/>

                        <TextBlock Text="Guardar"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>