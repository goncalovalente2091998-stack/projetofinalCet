<Window x:Class="GymManager.View.Forms.UtilizadorForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Utilizador"
        Icon="/GymManager;component/Assets/logo.ico"
        Height="680"
        Width="580"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1D4ED8">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="25,0">

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#33FFFFFF">

                    <materialDesign:PackIcon Kind="AccountCog"
                                             Width="30"
                                             Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                </Border>

                <StackPanel Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtTitulo"
                               Text="Novo Utilizador"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Conta de acesso ao sistema"
                               FontSize="13"
                               Foreground="#DDE7FF"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Background="White"
                    CornerRadius="14"
                    Padding="25"
                    Margin="25">

                <StackPanel>

                    <TextBox x:Name="txtNome"
                             Height="48"
                             Margin="0,0,0,16"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Nome"/>

                    <TextBox x:Name="txtEmail"
                             Height="48"
                             Margin="0,0,0,16"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="Email"/>

                    <PasswordBox x:Name="txtPassword"
                                 Height="48"
                                 Margin="0,0,0,16"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Palavra-passe"/>

                    <PasswordBox x:Name="txtConfirmarPassword"
                                 Height="48"
                                 Margin="0,0,0,20"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Confirmar palavra-passe"/>

                    <TextBlock Text="Perfil"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="cmbPerfil"
                              Height="48"
                              SelectedIndex="1"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="Administrador"
                                      Tag="Administrador"/>

                        <ComboBoxItem Content="Rececionista"
                                      Tag="Rececionista"/>

                        <ComboBoxItem Content="Professor"
                                      Tag="Professor"/>

                        <ComboBoxItem Content="Personal Trainer"
                                      Tag="Personal Trainer"/>

                    </ComboBox>

                    <TextBlock x:Name="txtAjudaPassword"
                               Text="Ao editar, deixe a palavra-passe vazia para manter a atual."
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               Visibility="Collapsed"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="20,0">

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="120"
                        Height="40"
                        Click="btnGuardar_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>